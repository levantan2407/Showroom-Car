@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Showroom-N3</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Main Navigation Bar -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom sticky-top">
            <div class="container">
                <!-- Brand Logo -->
                <a class="navbar-brand navbar-brand-logo" asp-controller="Home" asp-action="Index">
                    <span class="logo-icon"><i class="bi bi-shield-shaded"></i></span>
                    <span>AutoCare <span class="accent">Showroom</span></span>
                </a>

                <!-- Mobile Toggle -->
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Nav Items -->
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" 
                               asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Trang chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Cars" ? "active" : "")" 
                               asp-controller="Cars" asp-action="Index">
                                <i class="bi bi-car-front me-1"></i> Danh sách xe
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "active" : "")" 
                               asp-controller="Home" asp-action="About">
                                <i class="bi bi-info-circle me-1"></i> Giới thiệu
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "WarrantyPolicy" ? "active" : "")" 
                               asp-controller="Home" asp-action="WarrantyPolicy">
                                <i class="bi bi-shield-check me-1"></i> Chính sách bảo hành
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Contact" ? "active" : "")" 
                               asp-controller="Home" asp-action="Contact">
                                <i class="bi bi-headset me-1"></i> Liên hệ
                            </a>
                        </li>
                    </ul>

                    <!-- User Account Menu -->
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            var currentUser = await UserManager.GetUserAsync(User);
                            var isAdmin = User.IsInRole("Admin");

                            @if (isAdmin)
                            {
                                <li class="nav-item me-lg-2 my-1 my-lg-0">
                                    <a class="btn btn-primary btn-sm fw-bold px-3 shadow-sm" asp-controller="Admin" asp-action="Dashboard">
                                        <i class="bi bi-speedometer2 me-1"></i> Trang Quản trị
                                    </a>
                                </li>
                            }

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle fs-5 text-primary"></i>
                                    <span>@(currentUser?.FullName ?? User.Identity?.Name)</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="userMenu">
                                    <li class="px-3 py-2 text-muted small border-bottom">
                                        Đăng nhập với tư cách:<br />
                                        <strong class="text-dark">@(isAdmin ? "Quản trị viên (Admin)" : "Khách hàng (User)")</strong>
                                    </li>
                                    <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2 text-primary"></i>Hồ sơ cá nhân</a></li>
                                    @if (!isAdmin)
                                    {
                                        <li><a class="dropdown-item py-2" asp-controller="Orders" asp-action="MyOrders"><i class="bi bi-bag-check me-2 text-success"></i>Đơn đăng ký mua xe</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Warranties" asp-action="MyWarranties"><i class="bi bi-shield-check me-2 text-info"></i>Xe & Bảo hành của tôi</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Maintenance" asp-action="MyAppointments"><i class="bi bi-tools me-2 text-warning"></i>Lịch bảo dưỡng</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Maintenance" asp-action="MyHistories"><i class="bi bi-clock-history me-2 text-secondary"></i>Lịch sử bảo dưỡng</a></li>
                                    }
                                    <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key me-2 text-secondary"></i>Đổi mật khẩu</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item py-2 text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-lg-2">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-gold btn-sm" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i> Đăng ký
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Global Toast / TempData Notifications -->
    <div class="container mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle-fill fs-5 me-2"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- Main Body Content -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Public Footer -->
    <footer class="footer-custom">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <div class="navbar-brand-logo mb-3">
                        <span class="logo-icon"><i class="bi bi-shield-shaded"></i></span>
                        <span class="accent">Showroom</span>
                    </div>
                    <p class="small text-white-50 leading-relaxed mb-3">
                        AutoCare Showroom là hệ thống phân phối ô tô chính hãng và cung cấp dịch vụ bảo hành, bảo dưỡng chuyên nghiệp chuẩn quốc tế hàng đầu Việt Nam.
                    </p>
                    <div class="d-flex gap-2">
                        <a href="#" class="btn btn-sm btn-outline-light rounded-circle" style="width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="btn btn-sm btn-outline-light rounded-circle" style="width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;"><i class="bi bi-youtube"></i></a>
                        <a href="#" class="btn btn-sm btn-outline-light rounded-circle" style="width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;"><i class="bi bi-tiktok"></i></a>
                        <a href="#" class="btn btn-sm btn-outline-light rounded-circle" style="width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;"><i class="bi bi-instagram"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <h5>Hãng xe</h5>
                    <ul>
                        <li><a asp-controller="Cars" asp-action="Index" asp-route-brandId="1">Toyota</a></li>
                        <li><a asp-controller="Cars" asp-action="Index" asp-route-brandId="2">Honda</a></li>
                        <li><a asp-controller="Cars" asp-action="Index" asp-route-brandId="3">Mazda</a></li>
                        <li><a asp-controller="Cars" asp-action="Index" asp-route-brandId="4">Hyundai</a></li>
                        <li><a asp-controller="Cars" asp-action="Index" asp-route-brandId="5">Kia</a></li>
                        <li><a asp-controller="Cars" asp-action="Index" asp-route-brandId="6">Mercedes-Benz</a></li>
                        <li><a asp-controller="Cars" asp-action="Index" asp-route-brandId="7">BMW</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <h5>Dịch vụ</h5>
                    <ul>
                        <li><a asp-controller="Cars" asp-action="Index">Kinh doanh ô tô</a></li>
                        <li><a asp-controller="Home" asp-action="WarrantyPolicy">Chính sách bảo hành</a></li>
                        <li><a asp-controller="Warranties" asp-action="Check">Tra cứu bảo hành</a></li>
                        <li><a asp-controller="Maintenance" asp-action="Book">Đặt lịch bảo dưỡng</a></li>
                        <li><a asp-controller="Home" asp-action="About">Về AutoCare</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">Hỗ trợ khách hàng</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-6">
                    <h5>Thông tin liên hệ</h5>
                    <ul class="text-white-50 small">
                        <li class="d-flex gap-2 mb-2">
                            <i class="bi bi-geo-alt-fill text-warning flex-shrink-0 mt-1"></i>
                            <span>21 Tôn Thất Bật</span>
                        </li>
                        <li class="d-flex gap-2 mb-2">
                            <i class="bi bi-telephone-fill text-warning flex-shrink-0 mt-1"></i>
                            <span>Hotline tư vấn: <strong>0348076845</strong> (Miễn phí)</span>
                        </li>
                        <li class="d-flex gap-2 mb-2">
                            <i class="bi bi-envelope-fill text-warning flex-shrink-0 mt-1"></i>
                            <span>Email: levantan127@gmail.com</span>
                        </li>
                        <li class="d-flex gap-2 mb-2">
                            <i class="bi bi-shield-check text-warning flex-shrink-0 mt-1"></i>
                            <span>Trung tâm bảo hành: 8:00 - 17:30 (Tất cả các ngày)</span>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="border-top border-secondary pt-3 text-center small text-white-50">
                <p class="mb-0">© 2026 AutoCare Showroom. Bảo lưu mọi quyền. Hệ thống Quản lý Xe & Bảo hành.</p>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Custom JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
