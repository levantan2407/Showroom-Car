@model CarShowroom.ViewModels.WarrantyCheckViewModel
@{
    ViewData["Title"] = "Tra cứu bảo hành";
}

<div class="bg-dark text-white py-5 mb-5" style="background: linear-gradient(135deg, var(--primary-navy), var(--navy-card));">
    <div class="container text-center py-4">
        <h1 class="fw-bold mb-2">Tra Cứu Thông Tin Bảo Hành</h1>
        <p class="text-white-50 max-w-700 mx-auto">Kiểm tra thời hạn bảo hành chính hãng và tình trạng hồ sơ xe bằng Số VIN hoặc Mã bảo hành</p>
    </div>
</div>

<div class="container mb-5">
    <!-- Search Box -->
    <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 max-w-700 mx-auto bg-white mb-5">
        <form method="get" asp-action="Check">
            <label class="form-label fw-bold text-dark mb-2">Nhập Mã Bảo Hành hoặc Số VIN (Số khung xe)</label>
            <div class="input-group input-group-lg mb-3">
                <span class="input-group-text bg-light"><i class="bi bi-shield-lock-fill text-warning"></i></span>
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Ví dụ: WRT-2024-001 hoặc JTDKR3EH2MA234567" required autofocus />
                <button type="submit" class="btn btn-gold fw-bold px-4">
                    <i class="bi bi-search me-1"></i> Tra cứu
                </button>
            </div>
            <small class="text-muted d-block">
                * Mã bảo hành được cấp trên Giấy chứng nhận bàn giao xe, số VIN có thể xem trên đăng ký xe.
            </small>
        </form>
    </div>

    <!-- Search Result -->
    @if (Model.HasSearched)
    {
        @if (Model.Warranty != null)
        {
            var remainingDays = (Model.Warranty.EndDate - DateTime.Today).Days;
            var isExpired = remainingDays <= 0;

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden max-w-800 mx-auto bg-white">
                <div class="p-4 @(isExpired ? "bg-danger" : "bg-success") text-white d-flex justify-content-between align-items-center">
                    <div>
                        <span class="badge bg-white @(isExpired ? "text-danger" : "text-success") fw-bold mb-1">
                            @(isExpired ? "Hết hạn bảo hành" : "Đang được bảo hành")
                        </span>
                        <h4 class="fw-bold mb-0">Hồ Sơ Bảo Hành: @Model.Warranty.WarrantyCode</h4>
                    </div>
                    <div class="text-end">
                        <small class="d-block text-white-50">Thời hạn còn lại:</small>
                        <strong class="fs-4">@(isExpired ? "0 ngày" : $"{remainingDays} ngày")</strong>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    <div class="row g-4 mb-4">
                        <div class="col-md-6 border-end">
                            <h6 class="fw-bold text-muted text-uppercase small mb-3">Thông Tin Xe</h6>
                            <h5 class="fw-bold text-dark mb-1">@(Model.Warranty.Car?.Name ?? "Xe")</h5>
                            <ul class="list-unstyled small d-flex flex-column gap-2 mb-0 mt-3">
                                <li><strong class="text-muted">Hãng xe:</strong> @(Model.Warranty.Car?.Brand?.Name ?? "Chính hãng")</li>
                                <li><strong class="text-muted">Biển số:</strong> @(Model.Warranty.VehicleOwnership?.LicensePlate ?? "Chưa cấp")</li>
                                <li><strong class="text-muted">Số VIN:</strong> <span class="font-monospace">@(Model.Warranty.Car?.VIN ?? "---")</span></li>
                                <li><strong class="text-muted">Năm sản xuất:</strong> @(Model.Warranty.Car?.Year)</li>
                            </ul>
                        </div>

                        <div class="col-md-6 ps-md-4">
                            <h6 class="fw-bold text-muted text-uppercase small mb-3">Thời Hạn & Điều Kiện</h6>
                            <ul class="list-unstyled small d-flex flex-column gap-2 mb-0">
                                <li><strong class="text-muted">Ngày bắt đầu:</strong> @Model.Warranty.StartDate.ToString("dd/MM/yyyy")</li>
                                <li><strong class="text-muted">Ngày kết thúc:</strong> @Model.Warranty.EndDate.ToString("dd/MM/yyyy")</li>
                                <li><strong class="text-muted">Thời hạn gói:</strong> @Model.Warranty.WarrantyPeriodMonths tháng</li>
                                <li><strong class="text-muted">Chủ sở hữu:</strong> @(Model.Warranty.Customer?.FullName ?? "Khách hàng")</li>
                            </ul>
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded-3 small text-muted mb-4">
                        <strong class="text-dark d-block mb-1">Điều kiện áp dụng:</strong>
                        @(string.IsNullOrEmpty(Model.Warranty.Conditions) ? "Bảo hành chính hãng toàn quốc theo quy định của nhà sản xuất và tiêu chuẩn AutoCare Showroom." : Model.Warranty.Conditions)
                    </div>

                    <div class="d-flex flex-wrap gap-2 justify-content-end">
                        @if (!isExpired)
                        {
                            <a asp-action="CreateRequest" asp-route-warrantyId="@Model.Warranty.Id" class="btn btn-warning fw-bold btn-sm">
                                <i class="bi bi-tools me-1"></i> Gửi yêu cầu bảo hành cho xe này
                            </a>
                        }
                        <a asp-controller="Maintenance" asp-action="Book" class="btn btn-outline-dark btn-sm">
                            <i class="bi bi-calendar-check me-1"></i> Đặt lịch bảo dưỡng định kỳ
                        </a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm rounded-4 text-center py-5 max-w-700 mx-auto bg-white">
                <i class="bi bi-search text-danger" style="font-size: 3.5rem;"></i>
                <h5 class="fw-bold mt-3">Không tìm thấy hồ sơ bảo hành</h5>
                <p class="text-muted small">
                    Không có thông tin bảo hành nào khớp với từ khóa <strong>"@Model.SearchTerm"</strong>. Vui lòng kiểm tra lại Số VIN hoặc Mã bảo hành chính xác.
                </p>
                <div class="mt-2">
                    <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-secondary btn-sm">
                        Liên hệ bộ phận CSKH để được trợ giúp
                    </a>
                </div>
            </div>
        }
    }
</div>

