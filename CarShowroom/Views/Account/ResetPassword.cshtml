@model CarShowroom.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu mới";
}

<div class="container py-5 my-4">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="bg-dark text-white p-4 text-center" style="background: linear-gradient(135deg, var(--primary-navy), var(--navy-card));">
                    <div class="logo-icon mx-auto mb-2" style="width: 48px; height: 48px; font-size: 1.5rem;">
                        <i class="bi bi-shield-lock-fill text-warning"></i>
                    </div>
                    <h4 class="fw-bold mb-1">Thiết Lập Mật Khẩu Mới</h4>
                    <p class="text-white-50 small mb-0">Tài khoản: @Model.Email</p>
                </div>

                <div class="card-body p-4 p-md-5 bg-white">
                    <form asp-action="ResetPassword" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="Token" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted small">Tài khoản Email</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-envelope-check"></i></span>
                                <input type="text" class="form-control bg-light" value="@Model.Email" readonly />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
                                <input asp-for="NewPassword" class="form-control" placeholder="Tối thiểu 6 ký tự" autofocus />
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-lock-fill"></i></span>
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu mới" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-gold btn-lg w-100 fw-bold shadow-sm mb-3">
                            <i class="bi bi-check2-circle me-1"></i> Lưu Mật Khẩu Mới
                        </button>

                        <div class="text-center pt-2 border-top">
                            <p class="text-muted small mb-0">
                                <a asp-action="Login" class="text-primary fw-bold text-decoration-none">
                                    <i class="bi bi-arrow-left me-1"></i>Quay lại đăng nhập
                                </a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

