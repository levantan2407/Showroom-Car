@{
    ViewData["Title"] = "Từ chối truy cập";
}

<div class="container py-5 my-5 text-center">
    <div class="card border-0 shadow-sm rounded-4 p-5 max-w-700 mx-auto bg-white">
        <i class="bi bi-shield-x text-danger" style="font-size: 4.5rem;"></i>
        <h2 class="fw-bold text-dark mt-3">Truy Cập Bị Từ Chối</h2>
        <p class="text-muted leading-relaxed mb-4">
            Bạn không có đủ quyền hạn để truy cập vào khu vực này. Trang quản trị chỉ dành riêng cho Quản trị viên Showroom.
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Home" asp-action="Index" class="btn btn-navy px-4">
                <i class="bi bi-house-door me-1"></i> Về Trang Chủ
            </a>
            <a asp-action="Login" class="btn btn-outline-secondary px-4">
                Đăng Nhập Tài Khoản Khác
            </a>
        </div>
    </div>
</div>

