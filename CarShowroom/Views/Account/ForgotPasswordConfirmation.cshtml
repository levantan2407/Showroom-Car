@{
    ViewData["Title"] = "Xác nhận khôi phục mật khẩu";
    string resetLink = ViewBag.ResetLink as string ?? "#";
    string userEmail = ViewBag.UserEmail as string ?? "";
    string fullName = ViewBag.FullName as string ?? "";
}

<div class="container py-5 my-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="bg-dark text-white p-4 text-center" style="background: linear-gradient(135deg, var(--primary-navy), var(--navy-card));">
                    <div class="logo-icon mx-auto mb-2 text-success" style="width: 52px; height: 52px; font-size: 1.8rem;">
                        <i class="bi bi-shield-check text-success"></i>
                    </div>
                    <h4 class="fw-bold mb-1">Yêu Cầu Khôi Phục Thành Công</h4>
                    <p class="text-white-50 small mb-0">Hệ thống quản lý tài khoản AutoCare Showroom</p>
                </div>

                <div class="card-body p-4 p-md-5 bg-white text-center">
                    <div class="mb-4">
                        <div class="badge bg-success bg-opacity-10 text-success fs-6 px-3 py-2 rounded-pill mb-3">
                            <i class="bi bi-person-check-fill me-1"></i> Xác minh tài khoản thành công
                        </div>
                        <h5 class="fw-bold text-dark mb-1">@fullName</h5>
                        <div class="text-muted small font-monospace">@userEmail</div>
                    </div>

                    <div class="alert alert-info border-0 rounded-3 text-start small mb-4">
                        <div class="d-flex gap-2">
                            <i class="bi bi-info-circle-fill fs-5 text-primary flex-shrink-0"></i>
                            <div>
                                <strong>Thông báo môi trường hệ thống:</strong><br />
                                Yêu cầu khôi phục mật khẩu đã được hệ thống tạo mã xác thực (Token) an toàn. Vì hệ thống đang chạy trong môi trường nội bộ, bạn có thể bấm trực tiếp nút bên dưới để tiến hành thiết lập mật khẩu mới ngay lập tức.
                            </div>
                        </div>
                    </div>

                    <a href="@resetLink" class="btn btn-gold btn-lg w-100 fw-bold shadow-sm mb-3">
                        <i class="bi bi-arrow-right-circle-fill me-1"></i> Tiếp Tục Đặt Lại Mật Khẩu
                    </a>

                    <div class="pt-3 border-top">
                        <a asp-action="Login" class="text-muted small text-decoration-none">
                            <i class="bi bi-box-arrow-in-left me-1"></i> Quay về trang Đăng nhập
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

