@model CarShowroom.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="container py-5 my-4">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="bg-dark text-white p-4 text-center" style="background: linear-gradient(135deg, var(--primary-navy), var(--navy-card));">
                    <div class="logo-icon mx-auto mb-2" style="width: 48px; height: 48px; font-size: 1.5rem;">
                        <i class="bi bi-key-fill text-warning"></i>
                    </div>
                    <h4 class="fw-bold mb-1">Khôi Phục Mật Khẩu</h4>
                    <p class="text-white-50 small mb-0">Hệ thống quản lý tài khoản AutoCare Showroom</p>
                </div>

                <div class="card-body p-4 p-md-5 bg-white">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger py-2 small" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["ErrorMessage"]
                        </div>
                    }

                    <p class="text-muted small mb-4">
                        Vui lòng nhập địa chỉ <strong>Email</strong> bạn đã đăng ký với hệ thống. Chúng tôi sẽ hỗ trợ bạn thiết lập lại mật khẩu mới nhanh chóng.
                    </p>

                    <form asp-action="ForgotPassword" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <div class="mb-4">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control" placeholder="name@example.com" autofocus />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-gold btn-lg w-100 fw-bold shadow-sm mb-3">
                            <i class="bi bi-send-check me-1"></i> Gửi Yêu Cầu Khôi Phục
                        </button>

                        <div class="text-center pt-2 border-top">
                            <p class="text-muted small mb-0">
                                Nhớ mật khẩu của bạn? 
                                <a asp-action="Login" class="text-primary fw-bold text-decoration-none">
                                    <i class="bi bi-arrow-left me-1"></i>Quay lại đăng nhập
                                </a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card border-0 bg-light rounded-3 p-3 mt-3 shadow-sm">
                <small class="fw-bold text-dark d-block mb-1"><i class="bi bi-lightbulb-fill text-warning me-1"></i> Lưu ý:</small>
                <div class="small text-muted">
                    Nếu bạn quên cả Email đăng ký, vui lòng liên hệ Hotline <strong>0348076845</strong> hoặc ban quản trị để được hỗ trợ xác minh.
                </div>
            </div>
        </div>
    </div>
</div>

