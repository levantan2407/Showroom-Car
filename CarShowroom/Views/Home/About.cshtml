@{
    ViewData["Title"] = "Giới thiệu AutoCare Showroom";
}

<div class="bg-dark text-white py-5 mb-5" style="background: linear-gradient(135deg, var(--primary-navy), var(--navy-card));">
    <div class="container text-center py-4">
        <h1 class="fw-bold mb-2">Về AutoCare Showroom</h1>
        <p class="text-white-50 max-w-700 mx-auto">Hệ thống phân phối ô tô chính hãng và trung tâm dịch vụ bảo hành tiêu chuẩn quốc tế</p>
    </div>
</div>

<div class="container mb-5">
    <div class="row align-items-center g-5 mb-5">
        <div class="col-lg-6">
            <h3 class="fw-bold text-dark mb-3">Tầm Nhìn & Sứ Mệnh</h3>
            <p class="text-muted leading-relaxed">
                Được thành lập từ năm 2016, <strong>AutoCare Showroom</strong> đã từng bước vươn lên trở thành một trong những hệ thống showroom ô tô uy tín hàng đầu tại Việt Nam. Chúng tôi cam kết mang lại trải nghiệm mua sắm xe hơi tiện nghi, minh bạch cùng dịch vụ bảo hành, bảo dưỡng trọn đời cho chiếc xe của bạn.
            </p>
            <p class="text-muted leading-relaxed">
                Tại AutoCare Showroom, khách hàng không chỉ chọn được chiếc xe mơ ước với mức giá tốt nhất mà còn hoàn toàn yên tâm với chính sách hậu mãi: bảo hành động cơ hộp số 3 năm, hỗ trợ cứu hộ khẩn cấp 24/7 và hệ thống tra cứu bảo dưỡng trực tuyến minh bạch.
            </p>
            <div class="d-flex gap-4 pt-2">
                <div>
                    <h3 class="fw-bold text-primary mb-0">15.000+</h3>
                    <small class="text-muted">Xe đã bàn giao</small>
                </div>
                <div class="border-start ps-4">
                    <h3 class="fw-bold text-primary mb-0">99.2%</h3>
                    <small class="text-muted">Khách hàng hài lòng</small>
                </div>
                <div class="border-start ps-4">
                    <h3 class="fw-bold text-primary mb-0">20+</h3>
                    <small class="text-muted">Giải thưởng xuất sắc</small>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <img src="https://images.unsplash.com/photo-1562911791-c7a97b729ec5?auto=format&fit=crop&w=800&q=80" 
                 alt="Showroom Facilities" class="img-fluid rounded-4 shadow" />
        </div>
    </div>

    <!-- Facility standards -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-lg-5 mb-5 bg-light">
        <h4 class="fw-bold text-center mb-4">Cơ Sở Vật Chất & Xưởng Dịch Vụ</h4>
        <div class="row g-4 text-center">
            <div class="col-md-4">
                <div class="bg-white p-4 rounded-3 h-100 shadow-sm">
                    <i class="bi bi-building fs-1 text-primary mb-3"></i>
                    <h5 class="fw-bold">Showroom 3.000m²</h5>
                    <p class="text-muted small mb-0">Không gian trưng bày xe sang trọng, đầy đủ các phân khúc từ Sedan, SUV đến xe thể thao.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="bg-white p-4 rounded-3 h-100 shadow-sm">
                    <i class="bi bi-tools fs-1 text-warning mb-3"></i>
                    <h5 class="fw-bold">Xưởng Dịch Vụ 4S</h5>
                    <p class="text-muted small mb-0">20 khoang sửa chữa nhanh, máy quét chẩn đoán chuyên hãng và phòng sơn sấy công nghệ cao.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="bg-white p-4 rounded-3 h-100 shadow-sm">
                    <i class="bi bi-cup-hot fs-1 text-success mb-3"></i>
                    <h5 class="fw-bold">Phòng Chờ VIP</h5>
                    <p class="text-muted small mb-0">Khu vực nghỉ ngơi máy lạnh, wifi tốc độ cao, nước uống miễn phí trong khi chờ làm dịch vụ.</p>
                </div>
            </div>
        </div>
    </div>
</div>

