@model CarShowroom.ViewModels.CarFilterViewModel
@{
    ViewData["Title"] = "Danh sách xe ô tô";
}

<!-- Page Header -->
<div class="bg-dark text-white py-4 mb-4" style="background: linear-gradient(135deg, var(--primary-navy), var(--navy-card));">
    <div class="container d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h2 class="fw-bold mb-1">Danh Sách Xe Ô Tô</h2>
            <p class="text-white-50 mb-0 small">Khám phá các dòng xe chính hãng đang kinh doanh tại AutoCare Showroom</p>
        </div>
        <div>
            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold">
                Tìm thấy @Model.TotalItems xe
            </span>
        </div>
    </div>
</div>

<div class="container mb-5">
    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <form method="get" asp-action="Index">
            <div class="row g-3">
                <!-- Search Term -->
                <div class="col-lg-3 col-md-6">
                    <label class="form-label small fw-semibold text-muted">Từ khóa tìm kiếm</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                        <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="Tên xe, mã xe..." />
                    </div>
                </div>

                <!-- Brand Filter -->
                <div class="col-lg-2 col-md-6">
                    <label class="form-label small fw-semibold text-muted">Hãng xe</label>
                    <select name="BrandId" class="form-select">
                        <option value="">Tất cả hãng xe</option>
                        @foreach (var b in Model.Brands)
                        {
                            <option value="@b.Id" selected="@(Model.BrandId == b.Id)">@b.Name</option>
                        }
                    </select>
                </div>

                <!-- Category Filter -->
                <div class="col-lg-2 col-md-6">
                    <label class="form-label small fw-semibold text-muted">Loại xe</label>
                    <select name="CategoryId" class="form-select">
                        <option value="">Tất cả loại xe</option>
                        @foreach (var c in Model.Categories)
                        {
                            <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option>
                        }
                    </select>
                </div>

                <!-- Price Filter -->
                <div class="col-lg-3 col-md-6">
                    <label class="form-label small fw-semibold text-muted">Khoảng giá (VNĐ)</label>
                    <div class="d-flex gap-2">
                        <input type="number" name="MinPrice" value="@Model.MinPrice" class="form-control" placeholder="Từ" />
                        <input type="number" name="MaxPrice" value="@Model.MaxPrice" class="form-control" placeholder="Đến" />
                    </div>
                </div>

                <!-- Sorting -->
                <div class="col-lg-2 col-md-6">
                    <label class="form-label small fw-semibold text-muted">Sắp xếp</label>
                    <select name="SortOrder" class="form-select">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.SortOrder))">Mới nhất</option>
                        <option value="price_asc" selected="@(Model.SortOrder == "price_asc")">Giá: Thấp đến Cao</option>
                        <option value="price_desc" selected="@(Model.SortOrder == "price_desc")">Giá: Cao đến Thấp</option>
                        <option value="year_desc" selected="@(Model.SortOrder == "year_desc")">Năm: Mới nhất</option>
                    </select>
                </div>

                <!-- Filter Actions -->
                <div class="col-12 d-flex justify-content-end gap-2 pt-2 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-3 btn-sm">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Xóa bộ lọc
                    </a>
                    <button type="submit" class="btn btn-gold px-4 btn-sm fw-bold">
                        <i class="bi bi-funnel-fill me-1"></i> Lọc kết quả
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Cars Grid -->
    @if (!Model.Cars.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5">
            <div class="py-4">
                <i class="bi bi-car-front text-muted" style="font-size: 4rem;"></i>
                <h5 class="fw-bold mt-3">Không tìm thấy xe phù hợp</h5>
                <p class="text-muted small">Hãy thử thay đổi từ khóa tìm kiếm hoặc điều chỉnh khoảng giá.</p>
                <a asp-action="Index" class="btn btn-navy btn-sm mt-2">Xem tất cả xe</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4 mb-5">
            @foreach (var car in Model.Cars)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="car-card">
                        <div class="car-img-wrapper">
                            <img src="@(string.IsNullOrEmpty(car.ImageUrl) ? "https://images.unsplash.com/photo-1549399542-7e3f8b79c341?auto=format&fit=crop&w=800&q=80" : car.ImageUrl)" 
                                 alt="@car.Name" loading="lazy" />
                            
                            @if (car.Status == CarStatus.DangKinhDoanh)
                            {
                                <span class="car-badge-status badge-status-available">Đang kinh doanh</span>
                            }
                            else if (car.Status == CarStatus.DaBan)
                            {
                                <span class="car-badge-status badge-status-sold">Đã bán</span>
                            }
                            else if (car.Status == CarStatus.DaDatCoc)
                            {
                                <span class="car-badge-status badge-status-deposit">Đã đặt cọc</span>
                            }
                            else
                            {
                                <span class="car-badge-status badge-status-stopped">Ngừng kinh doanh</span>
                            }

                            <span class="car-badge-brand">@(car.Brand?.Name ?? "Chính hãng")</span>
                        </div>

                        <div class="car-card-body">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <span class="badge bg-light text-secondary border small">@car.CarCode</span>
                                <small class="text-muted">@(car.Category?.Name ?? "Xe")</small>
                            </div>

                            <h5 class="car-name" title="@car.Name">@car.Name</h5>
                            <div class="car-price">@car.Price.ToString("N0") VNĐ</div>

                            <div class="car-spec-grid">
                                <div class="car-spec-item">
                                    <i class="bi bi-calendar3"></i> Năm: <strong>@car.Year</strong>
                                </div>
                                <div class="car-spec-item">
                                    <i class="bi bi-people"></i> Chỗ: <strong>@(car.Seats ?? 5)</strong>
                                </div>
                                <div class="car-spec-item">
                                    <i class="bi bi-gear"></i> Hộp số: <strong>@(car.Transmission ?? "Tự động")</strong>
                                </div>
                                <div class="car-spec-item">
                                    <i class="bi bi-fuel-pump"></i> Nhiên liệu: <strong>@(car.FuelType ?? "Xăng")</strong>
                                </div>
                            </div>

                            <div class="mt-auto d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@car.Id" class="btn btn-outline-dark w-50 btn-sm fw-semibold">
                                    <i class="bi bi-eye me-1"></i> Chi tiết
                                </a>
                                @if (car.Status == CarStatus.DangKinhDoanh)
                                {
                                    <a asp-controller="Orders" asp-action="Create" asp-route-carId="@car.Id" class="btn btn-gold w-50 btn-sm">
                                        <i class="bi bi-cart-check me-1"></i> Mua xe
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-secondary w-50 btn-sm" disabled>
                                        @car.Status
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination Controls -->
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Page navigation" class="d-flex justify-content-center">
                <ul class="pagination shadow-sm">
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-CurrentPage="@(Model.CurrentPage - 1)"
                           asp-route-SearchTerm="@Model.SearchTerm"
                           asp-route-BrandId="@Model.BrandId"
                           asp-route-CategoryId="@Model.CategoryId"
                           asp-route-MinPrice="@Model.MinPrice"
                           asp-route-MaxPrice="@Model.MaxPrice"
                           asp-route-SortOrder="@Model.SortOrder">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-CurrentPage="@i"
                               asp-route-SearchTerm="@Model.SearchTerm"
                               asp-route-BrandId="@Model.BrandId"
                               asp-route-CategoryId="@Model.CategoryId"
                               asp-route-MinPrice="@Model.MinPrice"
                               asp-route-MaxPrice="@Model.MaxPrice"
                               asp-route-SortOrder="@Model.SortOrder">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-CurrentPage="@(Model.CurrentPage + 1)"
                           asp-route-SearchTerm="@Model.SearchTerm"
                           asp-route-BrandId="@Model.BrandId"
                           asp-route-CategoryId="@Model.CategoryId"
                           asp-route-MinPrice="@Model.MinPrice"
                           asp-route-MaxPrice="@Model.MaxPrice"
                           asp-route-SortOrder="@Model.SortOrder">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

