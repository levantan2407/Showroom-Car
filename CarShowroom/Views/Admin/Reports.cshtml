@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Báo cáo thống kê hoạt động kinh doanh & bảo hành";
    int selectedYear = ViewBag.SelectedYear;
    int? selectedMonth = ViewBag.SelectedMonth;
    var soldCars = ViewBag.SoldCars as List<CarShowroom.Models.VehicleOwnership> ?? new();
    var maintenanceRecords = ViewBag.MaintenanceRecords as List<CarShowroom.Models.MaintenanceHistory> ?? new();
    decimal totalRevenue = ViewBag.TotalRevenue;
    int totalSold = ViewBag.TotalSold;
    int totalMaintenanceRecords = ViewBag.TotalMaintenanceRecords;
    decimal totalMaintenanceCost = ViewBag.TotalMaintenanceCost;
    int activeWarranties = ViewBag.ActiveWarranties;
    int expiredWarranties = ViewBag.ExpiredWarranties;

    string periodText = selectedMonth.HasValue
        ? $"Tháng {selectedMonth.Value:D2} / {selectedYear}"
        : $"Năm {selectedYear}";
}

<!-- Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h4 class="fw-bold text-dark mb-0"><i class="bi bi-graph-up-arrow text-primary me-2"></i>Báo Cáo Thống Kê</h4>
        <small class="text-muted">Tổng hợp kết quả kinh doanh và dịch vụ bảo hành showroom - Kỳ: <strong>@periodText</strong></small>
    </div>
    <div>
        <a asp-action="ExportReport" asp-route-year="@selectedYear" asp-route-month="@selectedMonth" class="btn btn-success btn-sm fw-semibold shadow-sm px-3">
            <i class="bi bi-file-earmark-excel-fill me-1"></i> Xuất Excel (CSV)
        </a>
    </div>
</div>

<!-- Time Filter Card -->
<div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
    <form method="get" asp-action="Reports">
        <div class="row g-2 align-items-center">
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted mb-1">Năm báo cáo</label>
                <select name="year" class="form-select form-select-sm">
                    @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 3; y--)
                    {
                        <option value="@y" selected="@(selectedYear == y)">Năm @y</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted mb-1">Tháng báo cáo</label>
                <select name="month" class="form-select form-select-sm">
                    <option value="">Cả năm (12 Tháng)</option>
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(selectedMonth == m)">Tháng @m</option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end gap-2 pt-md-3">
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1"><i class="bi bi-funnel"></i> Xem báo cáo</button>
                <a asp-action="Reports" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-counterclockwise"></i> Mặc định</a>
            </div>
        </div>
    </form>
</div>

<!-- Report Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="stat-card">
            <div>
                <small class="text-muted text-uppercase fw-bold" style="font-size: 0.75rem;">Số xe đã bàn giao</small>
                <h3 class="fw-bold mb-0 text-success">@totalSold</h3>
                <small class="text-muted">Giao dịch hoàn tất</small>
            </div>
            <div class="stat-icon bg-success bg-opacity-10 text-success">
                <i class="bi bi-car-front"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6">
        <div class="stat-card">
            <div>
                <small class="text-muted text-uppercase fw-bold" style="font-size: 0.75rem;">Tổng doanh thu xe</small>
                <h4 class="fw-bold mb-0 text-danger">@totalRevenue.ToString("N0")</h4>
                <small class="text-muted">VNĐ</small>
            </div>
            <div class="stat-icon bg-danger bg-opacity-10 text-danger">
                <i class="bi bi-cash-stack"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6">
        <div class="stat-card">
            <div>
                <small class="text-muted text-uppercase fw-bold" style="font-size: 0.75rem;">Số lượt bảo dưỡng</small>
                <h3 class="fw-bold mb-0 text-primary">@totalMaintenanceRecords</h3>
                <small class="text-muted">Doanh thu BD: <strong>@totalMaintenanceCost.ToString("N0") đ</strong></small>
            </div>
            <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                <i class="bi bi-tools"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6">
        <div class="stat-card">
            <div>
                <small class="text-muted text-uppercase fw-bold" style="font-size: 0.75rem;">Tình trạng bảo hành</small>
                <h4 class="fw-bold mb-0 text-dark">@activeWarranties còn hạn</h4>
                <small class="text-muted">@expiredWarranties xe đã hết hạn</small>
            </div>
            <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                <i class="bi bi-shield-check"></i>
            </div>
        </div>
    </div>
</div>

<!-- 1. Detailed Table of Sold Cars -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
    <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
        <h6 class="fw-bold text-dark mb-0">
            <i class="bi bi-check2-circle text-success me-2"></i>1. Danh Sách Giao Dịch Bàn Giao Xe Trong Kỳ (@soldCars.Count)
        </h6>
        <span class="badge bg-white text-dark border">Tổng: @totalRevenue.ToString("N0") VNĐ</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light">
                <tr>
                    <th class="ps-3" style="width: 50px;">STT</th>
                    <th>Mã đơn</th>
                    <th>Ngày giao</th>
                    <th>Khách hàng</th>
                    <th>Số điện thoại</th>
                    <th>Xe bàn giao</th>
                    <th>Biển số</th>
                    <th>Số VIN</th>
                    <th class="text-end pe-3">Giá trị (VNĐ)</th>
                </tr>
            </thead>
            <tbody>
                @if (!soldCars.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">Không có giao dịch bàn giao xe nào trong kỳ báo cáo này.</td>
                    </tr>
                }
                else
                {
                    int idxCar = 1;
                    @foreach (var vo in soldCars)
                    {
                        <tr>
                            <td class="ps-3 text-muted">@(idxCar++)</td>
                            <td class="fw-bold text-primary font-monospace">DH@(vo.OrderId.ToString("D6"))</td>
                            <td>@vo.PurchaseDate.ToString("dd/MM/yyyy")</td>
                            <td><strong>@(vo.Customer?.FullName)</strong></td>
                            <td class="font-monospace">@(vo.Customer?.PhoneNumber ?? "---")</td>
                            <td>@(vo.Car?.Name)</td>
                            <td><span class="badge bg-light text-primary border">@(vo.LicensePlate ?? "Chưa cấp")</span></td>
                            <td class="font-monospace text-muted small">@(vo.Car?.VIN ?? "---")</td>
                            <td class="text-end pe-3"><strong class="text-danger">@vo.PurchasePrice.ToString("N0") VNĐ</strong></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- 2. Detailed Table of Maintenance Records -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
    <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
        <h6 class="fw-bold text-dark mb-0">
            <i class="bi bi-tools text-primary me-2"></i>2. Danh Sách Lượt Dịch Vụ Bảo Dưỡng Trong Kỳ (@maintenanceRecords.Count)
        </h6>
        <span class="badge bg-white text-dark border">Tổng chi phí: @totalMaintenanceCost.ToString("N0") VNĐ</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light">
                <tr>
                    <th class="ps-3" style="width: 50px;">STT</th>
                    <th>Ngày bảo dưỡng</th>
                    <th>Khách hàng</th>
                    <th>Số điện thoại</th>
                    <th>Tên xe</th>
                    <th>Nội dung bảo dưỡng</th>
                    <th>Ghi chú</th>
                    <th class="text-end pe-3">Chi phí (VNĐ)</th>
                </tr>
            </thead>
            <tbody>
                @if (!maintenanceRecords.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">Không có lượt bảo dưỡng nào trong kỳ báo cáo này.</td>
                    </tr>
                }
                else
                {
                    int idxMaint = 1;
                    @foreach (var m in maintenanceRecords)
                    {
                        <tr>
                            <td class="ps-3 text-muted">@(idxMaint++)</td>
                            <td>@m.MaintenanceDate.ToString("dd/MM/yyyy")</td>
                            <td><strong>@(m.Customer?.FullName)</strong></td>
                            <td class="font-monospace">@(m.Customer?.PhoneNumber ?? "---")</td>
                            <td>@(m.Car?.Name)</td>
                            <td>@(m.Content)</td>
                            <td class="text-muted small">@(m.Notes ?? "---")</td>
                            <td class="text-end pe-3"><strong class="text-primary">@((m.Cost ?? 0).ToString("N0")) VNĐ</strong></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
