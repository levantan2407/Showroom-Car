@model List<CarShowroom.Models.ApplicationUser>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý tài khoản";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold text-dark mb-0"><i class="bi bi-person-gear text-primary me-2"></i>Danh Sách Tài Khoản Người Dùng</h4>
        <small class="text-muted">Tổng cộng: @ViewBag.TotalItems tài khoản</small>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
    <form method="get" asp-action="Users">
        <div class="row g-2">
            <div class="col-md-10">
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control form-control-sm" placeholder="Tìm theo email, họ tên người dùng..." />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary btn-sm flex-grow-1"><i class="bi bi-search"></i> Tìm</button>
                <a asp-action="Users" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </div>
    </form>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Họ và tên</th>
                    <th>Email đăng nhập</th>
                    <th>Số điện thoại</th>
                    <th>Ngày tạo</th>
                    <th>Trạng thái tài khoản</th>
                    <th class="text-end pe-3">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td class="ps-3"><strong class="text-dark">@u.FullName</strong></td>
                        <td>@u.Email</td>
                        <td>@(u.PhoneNumber ?? "---")</td>
                        <td>@u.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2 py-1"><i class="bi bi-check-circle me-1"></i>Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger fw-bold px-2 py-1"><i class="bi bi-lock-fill me-1"></i>Đã bị khóa</span>
                            }
                        </td>
                        <td class="text-end pe-3">
                            <form asp-action="UserToggleStatus" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn thay đổi trạng thái hoạt động của tài khoản này?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn @(u.IsActive ? "btn-outline-danger" : "btn-outline-success") btn-sm py-0">
                                    <i class="bi @(u.IsActive ? "bi-lock" : "bi-unlock")"></i>
                                    @(u.IsActive ? "Khóa tài khoản" : "Mở khóa")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (totalPages > 1)
{
    <nav class="d-flex justify-content-center mt-4">
        <ul class="pagination pagination-sm shadow-sm">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(currentPage == i ? "active" : "")">
                    <a class="page-link" asp-action="Users" asp-route-page="@i" asp-route-searchTerm="@ViewBag.SearchTerm">@i</a>
                </li>
            }
        </ul>
    </nav>
}

