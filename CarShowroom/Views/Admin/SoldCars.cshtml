@model List<CarShowroom.Models.VehicleOwnership>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý xe đã bán";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold text-dark mb-0"><i class="bi bi-check2-circle text-success me-2"></i>Hồ Sơ Xe Đã Bàn Giao</h4>
        <small class="text-muted">Tổng cộng: @ViewBag.TotalItems xe đã bán thành công</small>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
    <form method="get" asp-action="SoldCars">
        <div class="row g-2">
            <div class="col-md-10">
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control form-control-sm" placeholder="Tìm theo tên khách hàng, tên xe, biển số, số VIN..." />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary btn-sm flex-grow-1"><i class="bi bi-search"></i> Tìm</button>
                <a asp-action="SoldCars" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </div>
    </form>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Xe đã bán</th>
                    <th>Chủ sở hữu</th>
                    <th>Biển số xe</th>
                    <th>Số VIN</th>
                    <th>Ngày bàn giao</th>
                    <th>Giá mua</th>
                    <th>Bảo hành</th>
                    <th class="text-end pe-3">Chi tiết</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">Chưa có bản ghi xe đã bán nào.</td>
                    </tr>
                }
                else
                {
                    @foreach (var vo in Model)
                    {
                        <tr>
                            <td class="ps-3">
                                <strong>@(vo.Car?.Name ?? "Xe")</strong>
                                <small class="text-muted d-block">Mã: @(vo.Car?.CarCode)</small>
                            </td>
                            <td>
                                <a asp-action="CustomerDetails" asp-route-id="@vo.CustomerId" class="text-dark fw-bold text-decoration-none">
                                    @(vo.Customer?.FullName ?? "---")
                                </a>
                                <small class="text-muted d-block">@(vo.Customer?.PhoneNumber)</small>
                            </td>
                            <td><span class="badge bg-light text-primary border">@(vo.LicensePlate ?? "Chưa cấp")</span></td>
                            <td><span class="font-monospace small">@(vo.Car?.VIN ?? "---")</span></td>
                            <td>@(vo.DeliveryDate?.ToString("dd/MM/yyyy") ?? vo.PurchaseDate.ToString("dd/MM/yyyy"))</td>
                            <td><strong class="text-danger">@vo.PurchasePrice.ToString("N0") VNĐ</strong></td>
                            <td>
                                @if (vo.Warranty != null)
                                {
                                    <a asp-action="WarrantyDetails" asp-route-id="@vo.Warranty.Id" class="badge bg-success text-decoration-none">
                                        @vo.Warranty.WarrantyCode
                                    </a>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Chưa kích hoạt</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <a asp-action="CustomerDetails" asp-route-id="@vo.CustomerId" class="btn btn-outline-info btn-sm py-0">
                                    Xem hồ sơ
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (totalPages > 1)
{
    <nav class="d-flex justify-content-center mt-4">
        <ul class="pagination pagination-sm shadow-sm">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(currentPage == i ? "active" : "")">
                    <a class="page-link" asp-action="SoldCars" asp-route-page="@i" asp-route-searchTerm="@ViewBag.SearchTerm">@i</a>
                </li>
            }
        </ul>
    </nav>
}

