@model List<CarShowroom.Models.Order>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý đơn đăng ký mua xe";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold text-dark mb-0"><i class="bi bi-receipt text-primary me-2"></i>Danh Sách Đơn Đăng Ký Mua Xe</h4>
        <small class="text-muted">Tổng cộng: @ViewBag.TotalItems đơn hàng</small>
    </div>
</div>

<!-- Filter Bar -->
<div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
    <form method="get" asp-action="Orders">
        <div class="row g-2">
            <div class="col-md-6">
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control form-control-sm" placeholder="Tìm theo mã đơn, họ tên, số điện thoại khách hàng..." />
            </div>
            <div class="col-md-4">
                <select name="status" class="form-select form-select-sm">
                    <option value="">Tất cả trạng thái đơn</option>
                    <option value="0" selected="@(ViewBag.Status != null && (int)ViewBag.Status == 0)">Chờ xác nhận</option>
                    <option value="1" selected="@(ViewBag.Status != null && (int)ViewBag.Status == 1)">Đã liên hệ</option>
                    <option value="2" selected="@(ViewBag.Status != null && (int)ViewBag.Status == 2)">Đã xác nhận</option>
                    <option value="3" selected="@(ViewBag.Status != null && (int)ViewBag.Status == 3)">Đang hoàn tất thủ tục</option>
                    <option value="4" selected="@(ViewBag.Status != null && (int)ViewBag.Status == 4)">Đã hoàn thành</option>
                    <option value="5" selected="@(ViewBag.Status != null && (int)ViewBag.Status == 5)">Đã hủy</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary btn-sm flex-grow-1"><i class="bi bi-search"></i> Tìm</button>
                <a asp-action="Orders" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </div>
    </form>
</div>

<!-- Orders Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Mã đơn</th>
                    <th>Khách hàng</th>
                    <th>Số điện thoại</th>
                    <th>Xe muốn mua</th>
                    <th>Hình thức</th>
                    <th>Ngày đăng ký</th>
                    <th>Trạng thái</th>
                    <th class="text-end pe-3">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">Không tìm thấy đơn hàng nào.</td>
                    </tr>
                }
                else
                {
                    @foreach (var o in Model)
                    {
                        <tr>
                            <td class="ps-3"><strong class="text-primary">@o.OrderCode</strong></td>
                            <td><strong>@o.CustomerName</strong></td>
                            <td>@o.CustomerPhone</td>
                            <td>
                                <div>@(o.Car?.Name ?? "Xe")</div>
                                <small class="text-danger fw-bold">@((o.Car?.Price ?? 0).ToString("N0")) VNĐ</small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @(o.PaymentMethod == PaymentMethod.TienMat ? "Tiền mặt" : "Trả góp")
                                </span>
                            </td>
                            <td>@o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @switch (o.Status)
                                {
                                    case OrderStatus.ChoXacNhan:
                                        <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Chờ xác nhận</span>
                                        break;
                                    case OrderStatus.DaLienHe:
                                        <span class="badge bg-info text-dark"><i class="bi bi-telephone-outbound me-1"></i>Đã liên hệ</span>
                                        break;
                                    case OrderStatus.DaXacNhan:
                                        <span class="badge bg-primary"><i class="bi bi-check-circle me-1"></i>Đã xác nhận</span>
                                        break;
                                    case OrderStatus.DangHoanTat:
                                        <span class="badge bg-secondary"><i class="bi bi-file-earmark-text me-1"></i>Đang thủ tục</span>
                                        break;
                                    case OrderStatus.DaHoanThanh:
                                        <span class="badge bg-success"><i class="bi bi-check2-all me-1"></i>Đã hoàn thành</span>
                                        break;
                                    case OrderStatus.DaHuy:
                                        <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Đã hủy</span>
                                        break;
                                }
                                @if (o.IsCancelRequested && o.Status != OrderStatus.DaHuy)
                                {
                                    <div class="mt-1">
                                        <span class="badge bg-danger text-white"><i class="bi bi-bell-fill me-1"></i>Khách yêu cầu hủy</span>
                                    </div>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <a asp-action="OrderDetails" asp-route-id="@o.Id" class="btn btn-outline-primary btn-sm py-0">
                                    <i class="bi bi-eye"></i> Xử lý đơn
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (totalPages > 1)
{
    <nav class="d-flex justify-content-center mt-4">
        <ul class="pagination pagination-sm shadow-sm">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(currentPage == i ? "active" : "")">
                    <a class="page-link" asp-action="Orders" asp-route-page="@i" asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-status="@ViewBag.Status">@i</a>
                </li>
            }
        </ul>
    </nav>
}

